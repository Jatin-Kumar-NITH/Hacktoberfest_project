# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models to try, in order (first that answers wins)
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it

# The owner account is created on first start. Only the owner can give admin access.
# Password needs 8+ characters with uppercase, lowercase, a number and a symbol.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Optional: secret for login cookies. If empty, one is generated in instance/secret_key.
SECRET_KEY=

# Email for one-time login codes (OTP). With Gmail: turn on 2-Step Verification,
# then create an App Password at https://myaccount.google.com/apppasswords and paste it below.
# If these are empty, codes are printed in the server window instead (fine for a local demo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
