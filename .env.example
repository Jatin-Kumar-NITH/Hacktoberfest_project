# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models to try, in order (first that answers wins)
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it

# Models that check uploaded PDFs for 18+ / vulgar content (uploads are blocked if none can check)
SAFETY_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# Google Sign-In: create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials and add your site's address
# (e.g. http://localhost:5000 and your Vercel URL) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Whoever signs in with this Google account is the owner. Only the owner can give admin access.
OWNER_EMAIL=
OWNER_NAME=

# Secret that signs login cookies (anyone who knows it can sign in as anyone). Set a long random value,
# e.g. from: python -c "import secrets; print(secrets.token_hex(32))". If empty, a random one is kept in
# the database (Postgres) or in instance/secret_key (SQLite).
SECRET_KEY=

# Optional: only let these email domains sign in (comma separated, e.g. nith.ac.in). Empty = any Google account.
# The owner can always sign in; ALLOWED_EMAILS lists other addresses that may sign in anyway.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Permanent database (required on Vercel, optional locally). Postgres URL, e.g. from Neon.
# If empty, a local SQLite file in instance/ is used.
DATABASE_URL=
