# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models to try, in order (first that answers wins)
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it

# Google Sign-In: create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials and add your site's address
# (e.g. http://localhost:5000 and your Vercel URL) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Whoever signs in with this Google account is the owner. Only the owner can give admin access.
OWNER_EMAIL=
OWNER_NAME=

# Optional: secret for login cookies. If empty, one is generated in instance/secret_key.
SECRET_KEY=

# Permanent database (required on Vercel, optional locally). Postgres URL, e.g. from Neon.
# If empty, a local SQLite file in instance/ is used.
DATABASE_URL=

# WhatsApp group intake: a long random secret the WhatsApp bot sends as "Authorization: Bearer <token>"
# to /api/bot/whatsapp. Leave empty to switch the intake off.
WHATSAPP_BOT_TOKEN=
