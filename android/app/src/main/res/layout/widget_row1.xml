<?xml version="1.0" encoding="utf-8"?>
<!-- One class on the widget: start time, subject, room. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_row1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
        android:id="@+id/w_time1"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:fontFeatureSettings="tnum" />

    <TextView
        android:id="@+id/w_name1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_room1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
</LinearLayout>
